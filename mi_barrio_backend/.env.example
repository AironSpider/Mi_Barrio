# Variables para desarrollo local. Copia a .env y reemplaza los valores.
# No compartas ni subas .env al repositorio.
DATABASE_URL=postgresql+asyncpg://USUARIO:CONTRASENA@localhost:5432/mi_barrio_db

# Obligatorio: genera una clave propia con `openssl rand -hex 32`.
# Déjala vacía en este archivo para no compartir una clave entre el equipo.
MI_BARRIO_JWT_SECRET=
